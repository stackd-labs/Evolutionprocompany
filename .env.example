# Copy to .env.local and fill in the real values there.
# .env.local is gitignored. THIS file IS committed — never put a real key here.

# --- Email (Resend) ---
# Create a key at resend.com/api-keys with sending permission.
RESEND_API_KEY=re_your_api_key_here

# Where form notifications are delivered.
ADMIN_EMAIL=info@yourdomain.com

# Sender for all outbound mail. The domain must be verified in Resend,
# otherwise every send is rejected.
FROM_EMAIL=EPC <info@yourdomain.com>

# --- Database (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
